# AudioNote configuration. Copy to .env and adjust per deployment.
# The SAME code runs everywhere; only these values change.

DB_DRIVER=sqlite            # sqlite | mysql
# TABLE_PREFIX=             # defaults: '' for sqlite, 'an_' for mysql
# SQLITE_PATH=audionote.db

# --- mysql only ---
# MYSQL_SECRETS_FILE=/etc/je9/je9_prime.je9   # file with JE9_PRIME_USER / JE9_PRIME_PASS
# MYSQL_HOST=127.0.0.1
# MYSQL_DB=je9_prime
# MYSQL_USER=
# MYSQL_PASS=

PORT=2600
BIND_ADDR=127.0.0.1
MUSIC_ROOT=

# --- transcription (local whisper; OFF unless you own the box AND the audio) ---
TRANSCRIBE_ENABLED=false
# WHISPER_BIN=whisper
# WHISPER_MODEL=base
# WHISPER_MODELS=tiny,base,small
# WHISPER_TIMEOUT_MS=1800000
# TRANSCRIPT_DIR=

# --- deployment presentation (previously hard-coded forks) ---
WEB_MODE=false
CHAT_ENABLED=false
CHAT_ENDPOINT=
SITE_BADGE=
SITE_BADGE_URL=
ANALYTICS=false
BRAND_NAME=AudioNote
BRAND_TAGLINE=
